# Postgres connection string. Railway injects this automatically when you
# attach a Postgres plugin to this service -- copy its DATABASE_URL reference.
DATABASE_URL=postgres://user:password@localhost:5432/felms_registration

# Shared password staff use to reach /staff. Change this before going live.
STAFF_PASSWORD=change-me

# Signs session cookies. Any long random string.
SESSION_SECRET=change-me-too

# Name of the current event, shown in headers across the app.
EVENT_NAME=FEL Motorsports -- 2026 Season

# Where uploaded headshots and documents are written. On Railway, mount a
# Volume at this path so files survive redeploys.
UPLOAD_DIR=./uploads

PORT=3000

# Set to 1 once the app is served over HTTPS end-to-end (true on Railway's
# default domain) so session cookies are marked Secure. Leave unset for local
# http:// development, or login cookies won't be sent back.
COOKIE_SECURE=1
