<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== "undefined" ? title + " — FEL Motorsports" : "FEL Motorsports" %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/theme.css">
</head>
<body>
<%
  var ICON = {
    idcard: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><circle cx="8.5" cy="12" r="2"/><path d="M13 10.5h6M13 14h4"/>'
  };
  function sideIcon(key) {
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + ICON[key] + '</svg>';
  }
  var STAFF_TABS = [
    { key: "dashboard", label: "Roster", href: "/staff" },
    { key: "teams", label: "Teams &amp; Allowances", href: "/staff/teams" },
    { key: "cards", label: "Hard Cards", href: "/staff/cards" },
    { key: "requests", label: "Credential Requests", href: "/staff/credential-requests" },
    { key: "documents", label: "Documents", href: "/staff/documents" }
  ];
  var PORTAL_TABS = [
    { key: "roster", label: "My Roster", href: "/portal" },
    { key: "credentials", label: "Credentials", href: "/portal/credentials" },
    { key: "documents", label: "Documents", href: "/portal/documents" }
  ];
%>
<% if (typeof nav !== "undefined" && (nav === "staff" || nav === "portal")) { %>
  <div class="felm-shell">
    <nav class="felm-side" aria-label="Primary">
      <div class="felm-side-mark">FEL</div>
      <div class="felm-side-items">
        <div class="felm-side-group">
          <a href="<%= nav === 'staff' ? '/staff' : '/portal' %>" class="felm-side-item active"><%- sideIcon('idcard') %><span><%= nav === "staff" ? "Registration" : "My Team" %></span></a>
        </div>
      </div>
      <div class="felm-side-foot">
        <span class="felm-side-avatar"><%= nav === "staff" ? "ST" : "TM" %></span>
        <span class="felm-side-id"><span class="n"><%= nav === "staff" ? "Staff" : (typeof team !== "undefined" && team ? team.name : "Team") %></span></span>
        <a class="felm-side-signout" href="<%= nav === 'staff' ? '/staff/logout' : '/portal/logout' %>">Sign out</a>
      </div>
    </nav>
    <div class="felm-main">
      <header class="felm-topbar">
        <div class="felm-topbar-left">
          <span class="felm-topbar-series">FEL Motorsports</span>
          <span class="felm-topbar-sep"></span>
          <span class="felm-topbar-place"><%= EVENT_NAME %></span>
        </div>
        <% if (typeof events !== "undefined" && events && events.length) { %>
          <details class="felm-eventpick">
            <summary class="felm-eventpick-sum">
              <span class="ep-round"><%= currentEvent ? currentEvent.round_label : "Select" %></span>
              <span class="ep-title"><%= currentEvent ? currentEvent.title : "a race weekend" %></span>
              <svg class="ep-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="felm-eventpick-panel">
              <div class="ep-panel-head"><%= nav === "staff" ? "Viewing registration for" : "Confirming registration for" %></div>
              <div class="ep-grid">
                <% events.forEach(function(e) { %>
                  <form method="post" action="<%= nav === 'staff' ? '/staff/event' : '/portal/event' %>" class="ep-card-form">
                    <input type="hidden" name="event_id" value="<%= e.id %>">
                    <button type="submit" class="ep-card <%= currentEvent && currentEvent.id === e.id ? 'active' : '' %>">
                      <span class="ep-card-round"><%= e.round_label %></span>
                      <span class="ep-card-title"><%= e.title %></span>
                      <% if (e.date_label) { %><span class="ep-card-date"><%= e.date_label %></span><% } %>
                    </button>
                  </form>
                <% }) %>
              </div>
            </div>
          </details>
        <% } %>
        <span class="felm-topbar-badge"><%= nav === "staff" ? "Credential Desk" : "Team Portal" %></span>
      </header>
      <nav class="felm-subnav">
        <% (nav === "staff" ? STAFF_TABS : PORTAL_TABS).forEach(function(t) { %>
          <a href="<%= t.href %>" class="sn-link <%= active === t.key ? 'active' : '' %>"><%- t.label %></a>
        <% }) %>
      </nav>
      <div class="felm-content">
<% } %>
