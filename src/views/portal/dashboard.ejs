<%- include('../partials/head', { title, nav, active }) %>
<div class="page-head">
  <div>
    <div class="kicker"><%= currentEvent ? currentEvent.round_label + ' — ' + currentEvent.title : EVENT_NAME %></div>
    <h1>Weekend Roster</h1>
    <div class="sub">Choose which of your roster members are attending this race weekend. FEL Motorsports staff can see every change here, with who and when.</div>
  </div>
  <div class="page-actions">
    <a class="btn" href="/portal/members">Manage Team Roster</a>
  </div>
</div>

<div class="wrap">
  <% if (flash) { %>
    <div class="flash success" style="margin-top:18px">
      <% if (flash==='attending') { %>Added to this weekend's roster.<% } %>
      <% if (flash==='notattending') { %>Removed from this weekend's roster.<% } %>
    </div>
  <% } %>

  <div class="panel" style="margin-top:18px">
    <div class="stats" style="grid-template-columns:repeat(2,1fr)">
      <div class="s-cell">
        <span class="label">Annual credentials</span>
        <div class="s-count cred"><em><%= usage.annualUsed %></em> <span style="color:var(--muted);font-size:13px">/ <%= usage.annualLimit != null ? usage.annualLimit : '∞' %></span></div>
        <% if (usage.annualOver) { %><div class="hint" style="color:#FF6B84">Over your allowance — request more under Credentials.</div><% } %>
      </div>
      <div class="s-cell">
        <span class="label">Single-event credentials</span>
        <div class="s-count waiver"><em><%= usage.singleUsed %></em> <span style="color:var(--muted);font-size:13px">/ <%= usage.singleLimit != null ? usage.singleLimit : '∞' %></span></div>
        <% if (usage.singleOver) { %><div class="hint" style="color:#FF6B84">Over your allowance — request more under Credentials.</div><% } %>
      </div>
    </div>
  </div>

  <div class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Attending this weekend (<%= attendingIds.size %> of <%= members.length %>)</h2></div>
    <% if (!members.length) { %>
      <div class="empty">Your team roster is empty. <a href="/portal/members">Add team members</a> first, then come back here to select who's attending each weekend.</div>
    <% } %>
    <div class="rowlist">
      <% members.forEach(function(m) { %>
        <% var attending = attendingIds.has(m.id); %>
        <div class="mrow">
          <span class="avatar">
            <% if (m.headshot_path) { %><img src="<%= m.headshot_path %>" alt=""><% } else { %><%= initials(m) %><% } %>
          </span>
          <div style="min-width:0">
            <div class="mr-name"><%= fullName(m) %></div>
            <div class="mr-role"><%= m.role || '—' %></div>
          </div>
          <div class="mr-right">
            <% if (attending) { %><span class="status-pill fulfilled">On weekend roster</span><% } %>
            <form class="inline" method="post" action="/portal/roster/toggle">
              <input type="hidden" name="member_id" value="<%= m.id %>">
              <button class="btn sm <%= attending ? 'danger' : 'primary' %>" type="submit"><%= attending ? 'Remove' : 'Add' %></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
