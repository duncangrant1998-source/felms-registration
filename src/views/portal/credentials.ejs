<%- include('../partials/head', { title, nav, active }) %>
<div class="page-head">
  <div>
    <div class="kicker"><%= currentEvent ? currentEvent.round_label + ' — ' + currentEvent.title : EVENT_NAME %></div>
    <h1>Credentials</h1>
    <div class="sub">Annual credentials used reflects who's attending the weekend selected above; single-event credentials used is a season total across every weekend. Request more below if you need to exceed your allowance.</div>
  </div>
</div>

<div class="wrap">
  <% if (flash==='requested') { %>
    <div class="flash success" style="margin-top:18px">Request sent — FEL Motorsports staff will follow up with payment details.</div>
  <% } %>

  <div class="panel" style="margin-top:18px">
    <div class="stats" style="grid-template-columns:repeat(2,1fr)">
      <div class="s-cell">
        <span class="label">Annual credentials used — this weekend</span>
        <div class="s-count cred"><em><%= usage.annualUsed %></em> <span style="color:var(--muted);font-size:13px">/ <%= usage.annualLimit != null ? usage.annualLimit : '∞' %></span></div>
      </div>
      <div class="s-cell">
        <span class="label">Single-event credentials used — season total</span>
        <div class="s-count waiver"><em><%= usage.singleUsed %></em> <span style="color:var(--muted);font-size:13px">/ <%= usage.singleLimit != null ? usage.singleLimit : '∞' %></span></div>
      </div>
    </div>
  </div>

  <div class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Request additional credentials</h2></div>
    <div class="panel-body">
      <p class="hint" style="margin-bottom:16px">
        Need more credentials than your allowance covers? Submit a request below and FEL Motorsports staff will
        reach out with a payment link to purchase the extras. <em>Online payment isn't wired up yet — this just
        notifies staff.</em>
      </p>
      <form method="post" action="/portal/credentials/request">
        <div class="form-grid">
          <div class="f">
            <label>Credential type</label>
            <select name="cred_type"><option>Annual</option><option>Single event</option></select>
          </div>
          <div class="f"><label>Quantity</label><input type="number" min="1" value="1" name="quantity"></div>
          <div class="f wide"><label>Note (optional)</label><textarea name="note" placeholder="e.g. adding a second mechanic for Round 3"></textarea></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Send Request</button></div>
      </form>
    </div>
  </div>

  <% if (requests.length) { %>
    <div class="panel" style="margin-top:18px">
      <div class="panel-head"><h2>Your requests</h2></div>
      <table class="simple">
        <thead><tr><th>Type</th><th>Qty</th><th>Note</th><th>Status</th></tr></thead>
        <tbody>
          <% requests.forEach(function(r) { %>
            <tr>
              <td><%= r.cred_type %></td>
              <td><%= r.quantity %></td>
              <td style="max-width:260px;overflow-wrap:anywhere"><%= r.note || '—' %></td>
              <td><span class="status-pill <%= r.status %>"><%= r.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
