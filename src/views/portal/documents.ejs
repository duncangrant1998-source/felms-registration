<%- include('../partials/head', { title, nav, active }) %>
<div class="page-head">
  <div>
    <div class="kicker"><%= EVENT_NAME %></div>
    <h1>Weekend Documents</h1>
    <div class="sub">Sporting regulations, technical regulations, speed waiver and anything else FEL Motorsports has posted for this event.</div>
  </div>
</div>

<div class="wrap">
  <% if (flash === 'docadded') { %>
    <div class="flash success" style="margin-top:18px">Document added.</div>
  <% } %>
  <% if (flash === 'docremoved') { %>
    <div class="flash success" style="margin-top:18px">Document removed.</div>
  <% } %>

  <div class="panel" style="margin-top:18px">
    <% if (!documents.length) { %>
      <div class="empty">No documents have been posted yet — check back closer to the event.</div>
    <% } %>
    <% var lastCat = null; %>
    <% documents.forEach(function(d) { %>
      <% if (d.category !== lastCat) { lastCat = d.category; %>
        <div class="group-head"><span class="g-name"><%= d.category %></span></div>
      <% } %>
      <div class="doc-row">
        <span class="doc-icon">📄</span>
        <div style="flex:1;min-width:0">
          <div class="doc-title"><%= d.title %></div>
          <div class="doc-meta">Posted <%= fmtDate(d.uploaded_at) %></div>
        </div>
        <a class="btn sm" href="<%= d.storage_path %>" target="_blank" rel="noopener">View / Download</a>
      </div>
    <% }) %>
  </div>

  <div class="panel" style="margin-top:18px">
    <div class="panel-head">
      <h2>Team Documents</h2>
    </div>
    <% if (!teamDocuments.length) { %>
      <div class="empty">
        <%= isAdmin ? 'No team documents yet — add one below for your team members to see.' : 'Your team admin hasn\'t posted any team documents yet.' %>
      </div>
    <% } %>
    <% teamDocuments.forEach(function(d) { %>
      <div class="doc-row">
        <span class="doc-icon">📄</span>
        <div style="flex:1;min-width:0">
          <div class="doc-title"><%= d.title %></div>
          <div class="doc-meta">Posted <%= fmtDate(d.uploaded_at) %></div>
        </div>
        <a class="btn sm" href="<%= d.storage_path %>" target="_blank" rel="noopener">View / Download</a>
        <% if (isAdmin) { %>
          <form class="inline" method="post" action="/portal/documents/team/<%= d.id %>/delete" onsubmit="return confirm('Remove this team document?');">
            <button class="btn sm danger" type="submit">Remove</button>
          </form>
        <% } %>
      </div>
    <% }) %>

    <% if (isAdmin) { %>
      <div class="panel-body" style="border-top:.8px solid var(--line-soft)">
        <form method="post" action="/portal/documents/team" enctype="multipart/form-data">
          <div class="form-grid">
            <div class="f"><label>Title</label><input name="title" placeholder="Team travel plan" required></div>
            <div class="f">
              <label>File</label>
              <input type="file" name="file" required>
            </div>
          </div>
          <div class="form-actions"><button class="btn primary" type="submit">Add Team Document</button></div>
        </form>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
