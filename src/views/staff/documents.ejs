<%- include('../partials/head', { title, nav, active }) %>
<div class="page-head">
  <div>
    <div class="kicker"><%= EVENT_NAME %></div>
    <h1>Weekend Documents</h1>
    <div class="sub">Sporting regs, technical regs, speed waiver and anything else teams need — visible to staff and teams alike.</div>
  </div>
</div>

<div class="wrap">
  <div class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Upload a document</h2></div>
    <div class="panel-body">
      <form method="post" action="/staff/documents" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="f"><label>Title</label><input name="title" placeholder="2026 Sporting Regulations" required></div>
          <div class="f">
            <label>Category</label>
            <input name="category" placeholder="Sporting Regulations" list="categoryList" autocomplete="off">
            <datalist id="categoryList">
              <% categories.forEach(function(c) { %><option value="<%= c %>"><% }) %>
            </datalist>
          </div>
          <div class="f wide"><label>File</label><input type="file" name="file" required></div>
        </div>

        <div class="f wide scope-field" style="margin-top:14px">
          <label>Applies to</label>
          <div style="display:flex;gap:18px;flex-wrap:wrap;margin-top:6px">
            <label style="display:flex;align-items:center;gap:7px;font-family:var(--font-body);font-size:14px;font-weight:400;text-transform:none;letter-spacing:0;color:var(--text);cursor:pointer">
              <input type="radio" name="scope" value="all" checked> All race weekends
            </label>
            <label style="display:flex;align-items:center;gap:7px;font-family:var(--font-body);font-size:14px;font-weight:400;text-transform:none;letter-spacing:0;color:var(--text);cursor:pointer">
              <input type="radio" name="scope" value="specific"> Specific weekend(s)
            </label>
          </div>
          <div class="scope-weekends">
            <% events.forEach(function(e) { %>
              <label style="display:flex;align-items:center;gap:7px;font-family:var(--font-body);font-size:14px;font-weight:400;text-transform:none;letter-spacing:0;color:var(--text);cursor:pointer">
                <input type="checkbox" name="event_ids" value="<%= e.id %>"> <%= e.round_label %> — <%= e.title %>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="form-actions"><button class="btn primary" type="submit">Upload</button></div>
      </form>
    </div>
  </div>

  <div class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Library</h2></div>
    <% if (!documents.length) { %>
      <div class="empty">No documents uploaded yet.</div>
    <% } %>
    <% documents.forEach(function(d) { %>
      <div class="doc-row">
        <span class="doc-icon">📄</span>
        <div style="flex:1;min-width:0">
          <div class="doc-title"><%= d.title %></div>
          <div class="doc-meta"><%= d.category %> · uploaded <%= fmtDate(d.uploaded_at) %> · <%= scopeByDoc[d.id] ? scopeByDoc[d.id].join(', ') : 'All weekends' %></div>
        </div>
        <a class="btn sm" href="<%= d.storage_path %>" target="_blank" rel="noopener">View</a>
        <form class="inline" method="post" action="/staff/documents/<%= d.id %>/delete" onsubmit="return confirm('Delete this document?');">
          <button class="btn sm danger" type="submit">Delete</button>
        </form>
      </div>
    <% }) %>
  </div>
</div>
<%- include('../partials/foot') %>
