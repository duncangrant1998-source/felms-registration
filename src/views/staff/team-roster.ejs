<%- include('../partials/head', { title, nav, active }) %>
<div class="page-head">
  <div>
    <div class="kicker"><a href="/staff/teams" style="color:var(--muted);text-decoration:none">&larr; Teams &amp; Allowances</a></div>
    <h1><%= team.name %></h1>
    <div class="sub">Full season roster, who's attending each race weekend, and a timestamped log of every change the team has made to their weekend rosters.</div>
  </div>
</div>

<div class="wrap">
  <div class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Full roster (<%= members.length %>)</h2></div>
    <% if (!members.length) { %>
      <div class="empty">This team hasn't added any members yet.</div>
    <% } %>
    <div class="rowlist">
      <% members.forEach(function(m) { %>
        <div class="mrow">
          <span class="avatar">
            <% if (m.headshot_path) { %><img src="<%= m.headshot_path %>" alt=""><% } else { %><%= initials(m) %><% } %>
          </span>
          <a href="/staff/members/<%= m.id %>" style="text-decoration:none;color:inherit;min-width:0">
            <div class="mr-name"><%= fullName(m) %></div>
            <div class="mr-role"><%= m.role || '—' %></div>
          </a>
          <div class="mr-right" style="flex-wrap:wrap;justify-content:flex-end">
            <span class="status-pill <%= accountComplete(m) ? 'fulfilled' : 'cancelled' %>"><%= accountComplete(m) ? 'Account Complete' : 'Missing Fields' %></span>
            <% events.forEach(function(e) { %>
              <% var on = attendingByEvent[e.id] && attendingByEvent[e.id].has(m.id); %>
              <span class="tag" style="<%= on ? 'border-color:var(--red-text);color:var(--red-text)' : 'opacity:.35' %>" title="<%= e.title %>"><%= e.round_label %></span>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Weekend credential usage</h2></div>
    <table class="simple">
      <thead><tr><th>Weekend</th><th>Annual attending</th><th>Single-event attending</th></tr></thead>
      <tbody>
        <% weekendBreakdown.forEach(function(w) { %>
          <tr>
            <td><%= w.event.round_label %> — <%= w.event.title %></td>
            <td>
              <%= w.annualCount %><%= team.annual_limit != null ? '/' + team.annual_limit : '' %>
              <% if (w.annualOver) { %><span class="g-warn" title="Over annual credential allowance" style="display:inline-flex;align-items:center;justify-content:center;margin-left:6px">!</span><% } %>
            </td>
            <td><%= w.singleCount %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="panel-body" style="padding:14px 20px;border-top:.8px solid var(--line-soft)">
      <span class="label">Single-event credentials used — season total</span>
      <div class="s-count waiver">
        <em><%= singleSeasonTotal %></em>
        <span style="color:var(--muted);font-size:13px">/ <%= team.single_limit != null ? team.single_limit : '∞' %></span>
        <% if (singleSeasonOver) { %><span class="g-warn" title="Over single-event credential allowance" style="display:inline-flex;align-items:center;justify-content:center;margin-left:6px">!</span><% } %>
      </div>
      <% if (singleSeasonOver) { %>
        <div class="hint" style="color:#FF6B84;margin-top:6px">Over the single-event allowance — follow up with the team if they need to purchase additional credentials.</div>
      <% } %>
    </div>
  </div>

  <div class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Weekend roster change log — <%= currentEvent ? currentEvent.round_label + ' — ' + currentEvent.title : 'this weekend' %></h2></div>
    <% if (!log.length) { %>
      <div class="empty">No roster changes recorded for this weekend yet.</div>
    <% } else { %>
      <table class="simple">
        <thead><tr><th>When</th><th>Member</th><th>Credential</th><th>Change</th></tr></thead>
        <tbody>
          <% log.forEach(function(l) { %>
            <tr>
              <td><%= fmtStamp(l.changed_at) %></td>
              <td><%= l.member_name %></td>
              <td><%= l.cred_type %></td>
              <td><span class="status-pill <%= l.action === 'added' ? 'fulfilled' : 'cancelled' %>"><%= l.action === 'added' ? 'Added' : 'Removed' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
